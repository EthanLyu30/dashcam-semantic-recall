# Backend API base used by the desktop client. Leave empty to use built-in mock data.
DVR_SEMANTIC_API_BASE=http://127.0.0.1:8000

# Multimodal model adapter. Supported provider values: qwen, deepseek, mock.
# When key is empty, the backend falls back to a rule-based mock analyzer.
MODEL_PROVIDER=mock
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=qwen-vl-plus

# SQLite (default for course demo) or a real DATABASE_URL.
DVR_SEMANTIC_DB_URL=sqlite:///./var/dvr_semantic.db

# Where uploaded videos / segments / frames / exports live.
MEDIA_ROOT=./var/media

# Bearer token signing secret. Replace before any non-local deployment.
DVR_SEMANTIC_JWT_SECRET=change-me-please
DVR_SEMANTIC_JWT_TTL_MIN=720

# ffmpeg / ffprobe binaries. Leave default if they are on PATH.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
