# Backend API base used by the desktop client. Leave empty to use built-in mock data.
DVR_SEMANTIC_API_BASE=http://127.0.0.1:8000

# Multimodal model adapter. Supported provider values: qwen, deepseek, mock.
# When key is empty, the backend falls back to a rule-based mock analyzer.
MODEL_PROVIDER=mock
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=qwen-vl-plus

# Database URL.
# PostgreSQL (recommended - native vector search):
# DVR_SEMANTIC_DB_URL=postgresql://postgres:postgres@localhost:5432/dvr_semantic
# SQLite fallback (zero-install, quick demo, no pgvector):
DVR_SEMANTIC_DB_URL=sqlite:///./var/dvr_semantic.db

# Where uploaded videos / segments / frames / exports live.
MEDIA_ROOT=./var/media

# Bearer token signing secret. MUST be replaced before any non-local deployment:
# the built-in default ships in this public source tree and would let anyone forge
# an admin token. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DVR_SEMANTIC_JWT_SECRET=change-me-please
DVR_SEMANTIC_JWT_TTL_MIN=720

# Deployment environment. Set to "production" to fail-closed at startup unless a
# non-default DVR_SEMANTIC_JWT_SECRET is configured. Leave empty for local demo.
DVR_SEMANTIC_ENV=

# Hard cap for a single upload, in bytes (default 10 GiB per SRS NFR-03).
# Oversized uploads are rejected with HTTP 413 before touching disk/memory.
DVR_SEMANTIC_MAX_UPLOAD_BYTES=10737418240

# FR-06 third-party integration: comma-separated API keys for /api/integration/*.
# Leave empty to keep the integration surface disabled (returns 503).
DVR_SEMANTIC_INTEGRATION_API_KEYS=

# NFR-02 auto-retry for transient model/network failures.
DVR_SEMANTIC_RETRY_ATTEMPTS=3
DVR_SEMANTIC_RETRY_BASE_DELAY=0.5

# ffmpeg / ffprobe binaries. Leave default if they are on PATH.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
